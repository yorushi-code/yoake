#!/usr/bin/bash
# The greetd entrypoint.
#
# greetd has no recovery of its own: if the greeter will not start, the machine
# simply cannot be logged into, and finding that out means a rescue VT and a
# text editor. That happened once already.
#
# So the fallback is not a guess about timing. greetd terminates the greeter
# with a signal once a session has been started, and a shell reports a
# signalled child as 128+N -- so an exit above 128 is the success case and
# anything else, at any point, is a greeter that gave up without logging anyone
# in. The stock greeter takes over in that case.

CONFIG=/usr/share/yshell/greeter/shell.qml
FALLBACK=/usr/bin/gtkgreet

qs -p "$CONFIG"
rc=$?

if [ "$rc" -le 128 ] && [ -x "$FALLBACK" ]; then
    echo "yshell greeter exited with $rc without starting a session; falling back" >&2
    exec "$FALLBACK"
fi

exit "$rc"
