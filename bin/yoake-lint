#!/usr/bin/env python3
"""Patterns that have already been bugs in this shell, looked for everywhere.

Each of these cost real debugging time once, and each was invisible: nothing
was logged, nothing threw, something simply did not appear. Finding the next
instance by reading is cheaper than finding it by noticing a cat that vanishes
between beats.

Direct children only, by brace depth. A scanner that reports a grandchild is a
scanner that gets ignored, and an ignored lint is worse than none.

Run with no arguments from anywhere; prints one line per finding and exits
non-zero if there are any.
"""

import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent


def blocks(text):
    """Every `TypeName {` block, as (type, id, body, start_line, depth).

    Braces inside strings and comments would break the count, so both are
    blanked first rather than parsed -- this only needs structure, not meaning.
    """
    clean = re.sub(r'"[^"\n]*"', lambda m: '"' + " " * (len(m.group(0)) - 2) + '"', text)
    clean = re.sub(r"//[^\n]*", lambda m: " " * len(m.group(0)), clean)

    out = []
    for m in re.finditer(r"\b([A-Z]\w*)\s*\{", clean):
        start = m.end() - 1
        depth = 0
        i = start
        while i < len(clean):
            if clean[i] == "{":
                depth += 1
            elif clean[i] == "}":
                depth -= 1
                if depth == 0:
                    break
            i += 1
        body = text[start + 1:i]
        line = text[:m.start()].count("\n") + 1
        # Not anchored to the start of a line: a one-line declaration puts
        # the id after the brace, and that is exactly the shape the
        # MultiEffect check needs to resolve.
        ident = re.search(r"(?:^|[{;\s])id:\s*(\w+)", body)
        out.append((m.group(1), ident.group(1) if ident else None, body, line, start))
    return out


def direct_children(body):
    """The blocks one level down, not their descendants."""
    out = []
    depth = 0
    i = 0
    while i < len(body):
        c = body[i]
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
        elif depth == 0:
            m = re.match(r"\b([A-Z]\w*)\s*\{", body[i:])
            if m:
                out.append((m.group(1), i))
                # Skip its body so its own children are not counted as ours.
                j = i + m.end() - 1
                d = 0
                while j < len(body):
                    if body[j] == "{":
                        d += 1
                    elif body[j] == "}":
                        d -= 1
                        if d == 0:
                            break
                    j += 1
                i = j
        i += 1
    return out


def _block_body(text, offset):
    """The body of the block that starts at `offset`, braces balanced."""
    start = text.index("{", offset)
    depth = 0
    for i in range(start, len(text)):
        if text[i] == "{":
            depth += 1
        elif text[i] == "}":
            depth -= 1
            if depth == 0:
                return text[start + 1:i]
    return text[start + 1:]


def check(path):
    text = path.read_text()
    found = []

    def report(line, what):
        found.append((path.name, line, what))

    all_blocks = blocks(text)

    # A MouseArea that is a direct child of a Row or Column is laid out as
    # another cell of it: it takes space, sits beside the content instead of
    # over it, and the thing it was meant to make clickable is not.
    #
    # Only the two shapes that are always wrong, so the rule stays worth
    # listening to. A MouseArea given a size of its own is a legitimate cell,
    # and a TapHandler is not an Item at all -- a positioner never lays one out,
    # so flagging it was simply incorrect.
    for kind, _, body, line, _ in all_blocks:
        if kind not in ("Row", "Column"):
            continue
        for child, offset in direct_children(body):
            if child != "MouseArea":
                continue
            inner = _block_body(body, offset)
            filled = re.search(r"anchors\.(fill|centerIn)\s*:", inner)
            sized = re.search(r"(?:^|[{;\s])(implicit)?(width|height)\s*:", inner, re.I)
            if not filled and sized:
                continue
            why = ("it is laid out as a cell, not over the row"
                   if filled else "it has no size of its own and catches nothing")
            report(line + body[:offset].count("\n"),
                   f"MouseArea is a direct child of a {kind}; {why}")

    # A Row positions its children; horizontal anchors on one are refused
    # outright and Qt disables the whole row.
    for kind, _, body, line, _ in all_blocks:
        if kind != "Row":
            continue
        # Only the anchors written one level down belong to direct children.
        for m in re.finditer(r"anchors\.(left|right|horizontalCenter|fill|centerIn)\s*:", body):
            d = body[:m.start()].count("{") - body[:m.start()].count("}")
            if d == 1:
                report(line + body[:m.start()].count("\n"),
                       f"anchors.{m.group(1)} on a direct child of a Row")

    # `parent` inside a GradientStop is the Gradient, which has no such
    # property; the undefined colour resolves to opaque black.
    for m in re.finditer(r"GradientStop\s*\{[^}]*\bparent\.(\w+)", text):
        report(text[:m.start()].count("\n") + 1,
               f"GradientStop reads parent.{m.group(1)}; parent there is the Gradient")

    # A MultiEffect draws nothing while its source has no texture of its own.
    ids = {i: b for _, i, b, _, _ in all_blocks if i}
    for kind, _, body, line, _ in all_blocks:
        if kind != "MultiEffect":
            continue
        m = re.search(r"(?:^|[{;\s])source:\s*(\w+)\s*(?:$|[;\n])", body, re.M)
        if not m:
            continue
        src = ids.get(m.group(1))
        if src is None:
            continue
        if re.search(r"(?:^|[{;\s])visible:\s*false", src) and "layer.enabled" not in src:
            report(line, f"MultiEffect source '{m.group(1)}' is hidden and has no layer")

    # Month and weekday names come from the system locale, and this session runs
    # under en_US: the bar read "Sun, 2 Aug" under a clock while the panel beside
    # it said "Воскресенье". Purely numeric formats are not affected, so only the
    # patterns that actually produce a name are worth reporting.
    for m in re.finditer(r"Qt\.format(?:DateTime|Date|Time)\s*\(([^)]*)\)", text):
        args = m.group(1)
        if re.search(r"MMM|ddd", args) and "locale" not in args.lower():
            report(text[:m.start()].count("\n") + 1,
                   "Qt.formatDate* with a name format and no locale; use Lang")
    for m in re.finditer(r"\.toLocale(?:Date|Time)?String\s*\(([^)]*)\)", text):
        args = m.group(1)
        if re.search(r"MMM|ddd", args) and not re.search(r"locale|Lang\b", args, re.I):
            report(text[:m.start()].count("\n") + 1,
                   "toLocaleString with a name format and no locale argument")

    # A Behavior on a property that the spectrum drives is an animation that is
    # restarted before it can finish, thirty times a second, forever. It never
    # reaches its target, it smears the reaction it was added to smooth, and it
    # was most of this shell's idle cost the first time it happened.
    # Only the three that carry a new number every frame. Cava.active and
    # Cava.barCount change when playback starts or the config does, and those
    # are exactly what a Behavior is for -- a rule that flags them is a rule
    # that gets switched off.
    live = re.compile(r"\bCava\.(values|peaks|bass)\b")
    for kind, _, body, line, _ in all_blocks:
        for m in re.finditer(r"Behavior\s+on\s+(\w+)", body):
            prop = m.group(1)
            depth = body[:m.start()].count("{") - body[:m.start()].count("}")
            if depth != 0:
                continue
            for b in re.finditer(rf"(?:^|[{{;\s]){prop}:\s*([^\n]*)", body):
                if b.start() < len(body) and live.search(b.group(1)):
                    report(line + body[:m.start()].count("\n"),
                           f"Behavior on {prop}, which is bound to the spectrum")
                    break

    return found


def missing_imports():
    """QtQuick types used in a file that does not import QtQuick.

    This one does not fail quietly like the rest: the type is simply not a
    type, so the whole configuration refuses to load and the desktop is gone
    until it is fixed. Adding a Connections to a singleton that only imported
    Quickshell is how it was found.
    """
    needs = {
        "QtQuick": ("Connections", "Timer", "Item", "Rectangle", "Text", "MouseArea",
                    "Row", "Column", "Repeater", "Component", "Behavior", "Image",
                    "Loader", "Flickable", "Canvas", "PropertyAnimation",
                    "NumberAnimation", "ColorAnimation", "SequentialAnimation",
                    "ParallelAnimation", "PauseAnimation"),
        "QtQuick.Effects": ("RectangularShadow", "MultiEffect"),
    }
    out = []
    for path in sorted(list(ROOT.glob("*.qml")) + list((ROOT / "greeter").glob("*.qml"))):
        text = path.read_text()
        for module, quick in needs.items():
            if re.search(rf"^\s*import\s+{re.escape(module)}\s*$", text, re.M):
                continue
        # Through blocks(), not a line-anchored match: `property Connections
        # x: Connections {` puts the type in the middle of the line, and a
        # rule that only looks at the start of one finds nothing at all --
        # which is exactly how this rule failed its own first test.
            for kind, _, _, line, _ in blocks(text):
                if kind in quick:
                    out.append((path.name, line,
                                f"{kind} needs `import {module}`; "
                                "without it the whole config fails to load"))
                    break
    return out


def unregistered():
    """Component files this shell's qmldir does not list.

    Quickshell resolves the directory through the qmldir rather than by
    scanning it, so a new .qml file is simply not a type until it is named
    there -- and the failure arrives as "X is not a type" at load, with the
    whole config refusing to start.
    """
    qmldir = ROOT / "qmldir"
    if not qmldir.exists():
        return []
    listed = set()
    for line in qmldir.read_text().splitlines():
        parts = line.split()
        # Plain and singleton entries differ only in a leading keyword, and the
        # file is the last field of both.
        if parts and parts[-1].endswith(".qml"):
            listed.add(parts[-1])
    out = []
    for path in sorted(ROOT.glob("*.qml")):
        if path.name in ("shell.qml",) or path.name in listed:
            continue
        out.append((path.name, 1, "not listed in qmldir; it will not be a type"))
    return out


def off_ladder():
    """Values written by hand where Theme has a rung for exactly that value.

    The shell was counted once: sixteen radii, twelve surface alphas, ten gaps
    and a hundred and forty font sizes, each chosen a surface at a time. None
    was individually wrong and the whole never read as one object. The ladders
    exist so that never happens again, and a ladder nobody is held to is a
    comment.

    Only the values a rung already covers are reported. A hero clock at 52 and
    a weather glyph at 42 are per-surface decisions, and a radius under four is
    half the height of a thin bar -- geometry, not a choice.
    """
    sizes = {"9", "10", "11", "12", "13", "15", "17"}
    radii = {"9", "10", "11", "12", "13", "16", "18", "22", "24"}
    out = []
    for path in sorted(ROOT.glob("*.qml")):
        if path.name == "Theme.qml":
            continue
        for n, line in enumerate(path.read_text().splitlines(), 1):
            if line.lstrip().startswith("//"):
                continue
            m = re.search(r"font\.pixelSize:\s*(\d+)\s*$", line)
            if m and m.group(1) in sizes:
                out.append((rel, n, f"font size {m.group(1)} has a rung in Theme"))
                continue
            m = re.search(r"\bradius:\s*(\d+)\s*$", line)
            if m and m.group(1) in radii:
                out.append((rel, n, f"radius {m.group(1)} has a rung in Theme"))
                continue
            m = re.search(r"Qt\.alpha\(Theme\.text,\s*(0\.\d+)\)", line)
            if m and m.group(1) in ("0.06", "0.10", "0.14", "0.18", "0.20"):
                out.append((path.name, n, f"surface alpha {m.group(1)} has a rung in Theme"))
    return out


def raw_icon_lookups():
    """Icon lookups that bypass the one helper.

    A theme can hold a name at 16, 22 and 24 and nothing larger; asked for it at
    a larger size by name the engine fails, and IconImage draws Qt's magenta
    checkerboard while still reporting itself Ready. Icons.forName is the only
    call that gets this right, and the bug survived one fix precisely because
    there were three spellings of the lookup to find.
    """
    out = []
    for path in sorted(ROOT.glob("*.qml")):
        if path.name == "Icons.qml":
            continue
        for n, line in enumerate(path.read_text().splitlines(), 1):
            if line.lstrip().startswith("//"):
                continue
            if "Quickshell.iconPath" in line or "Quickshell.hasThemeIcon" in line:
                out.append((path.name, n, "icon looked up directly; use Icons.forName"))
    return out


# ── Rungs, named once so the drift scan and the on-ladder scan agree ──
LADDER_RADII = {4, 10, 16, 24}
LADDER_SIZES = {9, 10, 11, 12, 13, 15, 22, 30, 40, 112, 12, 14, 17, 42}
# Three ladders, not one. The check below cannot tell them apart -- a fill, a
# veil and an ink presence are all `Qt.alpha(Theme.x, n)` -- so it holds the
# union and leaves which-is-which to the reader, who has the surrounding line.
LADDER_ALPHAS = {
    "0.06", "0.10", "0.14", "0.18", "0.20",   # fills and strokes
    "0.16", "0.26",                           # the same, in a colour
    "0.30", "0.45", "0.60", "0.75", "0.88",   # veils
    "0.80", "0.28",                           # ink presence (0.60/0.45 above)
}


def drift():
    """Values that belong to no rung at all.

    off_ladder() above catches a rung written as a number -- `radius: 10` where
    Theme.radiusChip says the same thing. It cannot catch the opposite and much
    commoner mistake, a value that is on no rung whatsoever, because it works by
    matching against the rungs themselves. That blind spot is why this file
    reported zero for months while the tree carried forty-four distinct surface
    alphas against a six-rung ladder -- the exact condition Theme.qml says it
    was written to end, back at four times the size it was when someone counted.

    Reported separately and not counted toward the exit status. These are design
    debt, not bugs: a scanner that turns one broken cat into a hundred and fifty
    spacing complaints is a scanner nobody runs, and this file's own rule is
    that an ignored lint is worse than none. Green still means the shell works.
    """
    out = []
    for path in sorted(list(ROOT.glob("*.qml")) + list((ROOT / "greeter").glob("*.qml"))):
        if path.name == "Theme.qml":
            continue
        # greeter/shell.qml and shell.qml share a basename, and a report that
        # cannot tell them apart sends you to the wrong file.
        rel = str(path.relative_to(ROOT))
        text = path.read_text()

        # A radius on a RectangularShadow is not a shape. It is the corner of
        # the blur, and it has to match whatever it sits under -- inset by the
        # shadow's own negative margin, which is how DesktopWidget arrives at 26
        # for a 20-radius widget pushed out by 6. Flagging those taught the
        # reader to "fix" correct code, which is the one thing this file must
        # never do.
        shadow_lines = set()
        for kind, _, body, line, _ in blocks(text):
            if kind == "RectangularShadow":
                shadow_lines.update(range(line, line + body.count("\n") + 2))

        for n, line in enumerate(text.splitlines(), 1):
            stripped = line.lstrip()
            if stripped.startswith("//"):
                continue

            # Anything under four is half the height of a thin bar: geometry,
            # not a choice, and the same exemption off_ladder() already makes.
            m = re.search(r"\bradius:\s*(\d+)\s*$", line)
            if (m and n not in shadow_lines
                    and int(m.group(1)) >= 4 and int(m.group(1)) not in LADDER_RADII):
                out.append((rel, n, f"radius {m.group(1)} is on no rung of the shape ladder"))

            # Every duration in the shell should now be a Theme rung, because
            # the rungs are the only ones that scale with Perception's tempo. A
            # literal here does not merely drift from the ladder -- it stands
            # still while the whole shell speeds up and slows down around it.
            # Not anchored to end of line: half the shell writes its animations
            # inline as `{ duration: 900 }`, and an anchored rule found eight of
            # them out of sixty -- which is how a measurement quietly agrees
            # with whoever wrote it. A trailing `0` is exempt because that is
            # the `shown ? delay : 0` idiom, an absence of animation rather than
            # a duration chosen by hand.
            m = re.search(r"\bduration:\s*(.+)$", line)
            if m:
                # Every integer in the expression, not just one sitting alone
                # after the colon. The anchored form missed
                # `duration: open ? 180 : Theme.animExit` entirely -- a literal
                # hiding inside a ternary, in the launcher, for as long as the
                # check has existed. A rule that only sees the easy shape is a
                # measurement that agrees with whoever wrote it.
                # `0` is exempt: that is the `shown ? delay : 0` idiom, an
                # absence of animation rather than a duration chosen by hand.
                for num in re.finditer(r"(?<![\w.])(\d+)(?![\w.])", m.group(1)):
                    if num.group(1) == "0":
                        continue
                    out.append((rel, n,
                                f"duration {num.group(1)} is a literal; "
                                "it will not follow the tempo"))

            m = re.search(r"font\.pixelSize:\s*(\d+)\s*$", line)
            if m and int(m.group(1)) not in LADDER_SIZES:
                out.append((rel, n, f"font size {m.group(1)} is on no rung of the type scale"))

            for m in re.finditer(r"Qt\.alpha\(\s*Theme\.\w+\s*,\s*(0?\.\d+)\s*\)", line):
                v = m.group(1)
                norm = f"{float(v):.2f}"
                if norm not in LADDER_ALPHAS:
                    out.append((rel, n, f"surface alpha {v} is on no rung of the surface ladder"))
    return out


def summarise(rows):
    """Counts by kind, so the size of each problem is legible without scrolling."""
    kinds = {}
    for _, _, what in rows:
        key = what.split(" is ")[0].split(" ")[0]
        kinds[key] = kinds.get(key, 0) + 1
    return kinds


def main():
    findings = []
    for path in sorted(list(ROOT.glob("*.qml")) + list((ROOT / "greeter").glob("*.qml"))):
        findings.extend(check(path))
    findings.extend(unregistered())
    findings.extend(missing_imports())
    findings.extend(raw_icon_lookups())
    findings.extend(off_ladder())

    for name, line, what in findings:
        print(f"{name}:{line}: {what}")
    print(f"\n{len(findings)} finding{'' if len(findings) == 1 else 's'}")

    rows = drift()
    if rows:
        if "--drift" in sys.argv:
            print()
            for name, line, what in rows:
                print(f"{name}:{line}: {what}")
        print("\ndrift (not counted; run with --drift for the list):")
        for kind, count in sorted(summarise(rows).items(), key=lambda kv: -kv[1]):
            print(f"  {count:4d}  {kind}")

    return 1 if findings else 0


if __name__ == "__main__":
    sys.exit(main())
