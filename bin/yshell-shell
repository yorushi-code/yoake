#!/usr/bin/bash
# Starts the shell, and only ever one of it.
#
# `qs` and `qs -p <path>` load the same configuration but are separate
# instances as far as Quickshell is concerned, so a second copy can end up
# running with nothing on screen saying so. Two of everything, including a
# second decoder for the video wallpaper -- which is what "the wallpaper
# sometimes plays slowly" was: 36.8% and 18.9% of a core, both drawing the same
# desktop.
#
# Idempotent on purpose: running this again replaces the shell rather than
# adding to it.

CONFIG="$HOME/.config/quickshell/shell.qml"
GREETER_MARK="/usr/share/yshell/greeter"

others() {
    local pid
    for pid in $(pgrep -x qs 2>/dev/null); do
        [ "$pid" = "$$" ] && continue
        # The login greeter runs the same binary and is none of our business.
        if tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | grep -qF "$GREETER_MARK"; then
            continue
        fi
        printf '%s\n' "$pid"
    done
}

for pid in $(others); do
    kill "$pid" 2>/dev/null
done

# A notification daemon that is not this shell has to go first.
#
# mako was replaced by yshell in July, but its D-Bus activation file is still
# installed: the moment the shell is not holding org.freedesktop.Notifications
# and anything posts a notification, systemd starts mako and it keeps the name.
# The shell then comes up with no notifications at all -- no toasts of its own,
# no history, "do not disturb" applying to nothing -- and the only sign is one
# line in the log saying registration failed. It happened during a restart and
# took a while to notice, which is exactly how long it would take anyone else.
#
# Left activatable on purpose rather than masked, so it still stands in if this
# shell dies; it just does not get to keep the name once the shell is back.
pkill -x mako 2>/dev/null

# Let them release their Wayland surfaces before taking the layer back.
for _ in $(seq 1 30); do
    [ -z "$(others)" ] && break
    sleep 0.1
done

# Anything still standing after three seconds is not going to leave politely,
# and carrying on regardless would produce exactly the two shells this script
# exists to prevent.
for pid in $(others); do
    kill -9 "$pid" 2>/dev/null
done

exec qs -p "$CONFIG"
