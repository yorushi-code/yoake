#!/usr/bin/python3
"""Plays the shell's event sounds, one process for the whole session.

Spawning a player per event is a fork and an exec on the click, which is both
the latency and the cost. This keeps one mpv running with its IPC socket open
and hands it a file to play, so an event costs a line written to a socket.

Reads event names on stdin, one per line. Unknown names are ignored rather than
logged: the shell must never be able to make this noisy.
"""
import json
import os
import shutil
import socket
import subprocess
import sys
import time

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
SOCKET = os.path.join(RUNTIME, "yoake-sfx.sock")
HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SAMPLES = os.path.join(HERE, "assets", "sfx")
# Shipped with Fedora and good enough to stand in for anything missing.
FALLBACK = "/usr/share/sounds/freedesktop/stereo"


def sample_for(name):
    own = os.path.join(SAMPLES, name + ".wav")
    if os.path.exists(own):
        return own
    spare = os.path.join(FALLBACK, name + ".oga")
    return spare if os.path.exists(spare) else None


def start_mpv():
    if os.path.exists(SOCKET):
        os.unlink(SOCKET)
    # media.role=event keeps PipeWire from filing these as music, which also
    # keeps them out of the shell's own stream list -- a click that appears in
    # the mixer it was triggered from is a bug people notice immediately.
    env = dict(os.environ, PIPEWIRE_PROPS='{ media.role = event }')
    proc = subprocess.Popen(
        ["mpv", "--idle=yes", "--no-video", "--no-terminal", "--audio-display=no",
         "--keep-open=no", "--input-ipc-server=" + SOCKET],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
    for _ in range(100):
        if os.path.exists(SOCKET):
            break
        time.sleep(0.05)
    return proc


def main():
    if not shutil.which("mpv"):
        return 1
    proc = start_mpv()
    conn = None
    for _ in range(40):
        try:
            conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            conn.connect(SOCKET)
            break
        except OSError:
            conn = None
            time.sleep(0.05)
    if conn is None:
        proc.terminate()
        return 1

    volume = 70
    for line in sys.stdin:
        parts = line.strip().split()
        if not parts:
            continue
        if parts[0] == "volume" and len(parts) > 1:
            try:
                volume = max(0, min(100, int(parts[1])))
                conn.sendall((json.dumps(
                    {"command": ["set_property", "volume", volume]}) + "\n").encode())
            except (ValueError, OSError):
                pass
            continue
        path = sample_for(parts[0])
        if path is None:
            continue
        try:
            conn.sendall((json.dumps(
                {"command": ["loadfile", path, "replace"]}) + "\n").encode())
        except OSError:
            break

    try:
        conn.close()
    finally:
        proc.terminate()
    return 0


if __name__ == "__main__":
    sys.exit(main())
