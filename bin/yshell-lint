#!/usr/bin/env python3
"""Patterns that have already been bugs in this shell, looked for everywhere.

Each of these cost real debugging time once, and each was invisible: nothing
was logged, nothing threw, something simply did not appear. Finding the next
instance by reading is cheaper than finding it by noticing a cat that vanishes
between beats.

Direct children only, by brace depth. A scanner that reports a grandchild is a
scanner that gets ignored, and an ignored lint is worse than none.

Run with no arguments from anywhere; prints one line per finding and exits
non-zero if there are any.
"""

import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent


def blocks(text):
    """Every `TypeName {` block, as (type, id, body, start_line, depth).

    Braces inside strings and comments would break the count, so both are
    blanked first rather than parsed -- this only needs structure, not meaning.
    """
    clean = re.sub(r'"[^"\n]*"', lambda m: '"' + " " * (len(m.group(0)) - 2) + '"', text)
    clean = re.sub(r"//[^\n]*", lambda m: " " * len(m.group(0)), clean)

    out = []
    for m in re.finditer(r"\b([A-Z]\w*)\s*\{", clean):
        start = m.end() - 1
        depth = 0
        i = start
        while i < len(clean):
            if clean[i] == "{":
                depth += 1
            elif clean[i] == "}":
                depth -= 1
                if depth == 0:
                    break
            i += 1
        body = text[start + 1:i]
        line = text[:m.start()].count("\n") + 1
        # Not anchored to the start of a line: a one-line declaration puts
        # the id after the brace, and that is exactly the shape the
        # MultiEffect check needs to resolve.
        ident = re.search(r"(?:^|[{;\s])id:\s*(\w+)", body)
        out.append((m.group(1), ident.group(1) if ident else None, body, line, start))
    return out


def direct_children(body):
    """The blocks one level down, not their descendants."""
    out = []
    depth = 0
    i = 0
    while i < len(body):
        c = body[i]
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
        elif depth == 0:
            m = re.match(r"\b([A-Z]\w*)\s*\{", body[i:])
            if m:
                out.append((m.group(1), i))
                # Skip its body so its own children are not counted as ours.
                j = i + m.end() - 1
                d = 0
                while j < len(body):
                    if body[j] == "{":
                        d += 1
                    elif body[j] == "}":
                        d -= 1
                        if d == 0:
                            break
                    j += 1
                i = j
        i += 1
    return out


def check(path):
    text = path.read_text()
    found = []

    def report(line, what):
        found.append((path.name, line, what))

    all_blocks = blocks(text)

    # A MouseArea that is a direct child of a Row or Column is laid out as
    # another cell of it: it takes space, sits beside the content instead of
    # over it, and the thing it was meant to make clickable is not.
    for kind, _, body, line, _ in all_blocks:
        if kind not in ("Row", "Column"):
            continue
        for child, offset in direct_children(body):
            if child in ("MouseArea", "TapHandler"):
                report(line + body[:offset].count("\n"),
                       f"{child} is a direct child of a {kind}; it is laid out as a cell")

    # A Row positions its children; horizontal anchors on one are refused
    # outright and Qt disables the whole row.
    for kind, _, body, line, _ in all_blocks:
        if kind != "Row":
            continue
        # Only the anchors written one level down belong to direct children.
        for m in re.finditer(r"anchors\.(left|right|horizontalCenter|fill|centerIn)\s*:", body):
            d = body[:m.start()].count("{") - body[:m.start()].count("}")
            if d == 1:
                report(line + body[:m.start()].count("\n"),
                       f"anchors.{m.group(1)} on a direct child of a Row")

    # `parent` inside a GradientStop is the Gradient, which has no such
    # property; the undefined colour resolves to opaque black.
    for m in re.finditer(r"GradientStop\s*\{[^}]*\bparent\.(\w+)", text):
        report(text[:m.start()].count("\n") + 1,
               f"GradientStop reads parent.{m.group(1)}; parent there is the Gradient")

    # A MultiEffect draws nothing while its source has no texture of its own.
    ids = {i: b for _, i, b, _, _ in all_blocks if i}
    for kind, _, body, line, _ in all_blocks:
        if kind != "MultiEffect":
            continue
        m = re.search(r"(?:^|[{;\s])source:\s*(\w+)\s*(?:$|[;\n])", body, re.M)
        if not m:
            continue
        src = ids.get(m.group(1))
        if src is None:
            continue
        if re.search(r"(?:^|[{;\s])visible:\s*false", src) and "layer.enabled" not in src:
            report(line, f"MultiEffect source '{m.group(1)}' is hidden and has no layer")

    # Month and weekday names come from the system locale, and this session runs
    # under en_US: the bar read "Sun, 2 Aug" under a clock while the panel beside
    # it said "Воскресенье". Purely numeric formats are not affected, so only the
    # patterns that actually produce a name are worth reporting.
    for m in re.finditer(r"Qt\.format(?:DateTime|Date|Time)\s*\(([^)]*)\)", text):
        args = m.group(1)
        if re.search(r"MMM|ddd", args) and "locale" not in args.lower():
            report(text[:m.start()].count("\n") + 1,
                   "Qt.formatDate* with a name format and no locale; use Lang")
    for m in re.finditer(r"\.toLocale(?:Date|Time)?String\s*\(([^)]*)\)", text):
        args = m.group(1)
        if re.search(r"MMM|ddd", args) and not re.search(r"locale|Lang\b", args, re.I):
            report(text[:m.start()].count("\n") + 1,
                   "toLocaleString with a name format and no locale argument")

    # A Behavior on a property that the spectrum drives is an animation that is
    # restarted before it can finish, thirty times a second, forever. It never
    # reaches its target, it smears the reaction it was added to smooth, and it
    # was most of this shell's idle cost the first time it happened.
    # Only the three that carry a new number every frame. Cava.active and
    # Cava.barCount change when playback starts or the config does, and those
    # are exactly what a Behavior is for -- a rule that flags them is a rule
    # that gets switched off.
    live = re.compile(r"\bCava\.(values|peaks|bass)\b")
    for kind, _, body, line, _ in all_blocks:
        for m in re.finditer(r"Behavior\s+on\s+(\w+)", body):
            prop = m.group(1)
            depth = body[:m.start()].count("{") - body[:m.start()].count("}")
            if depth != 0:
                continue
            for b in re.finditer(rf"(?:^|[{{;\s]){prop}:\s*([^\n]*)", body):
                if b.start() < len(body) and live.search(b.group(1)):
                    report(line + body[:m.start()].count("\n"),
                           f"Behavior on {prop}, which is bound to the spectrum")
                    break

    return found


def unregistered():
    """Component files this shell's qmldir does not list.

    Quickshell resolves the directory through the qmldir rather than by
    scanning it, so a new .qml file is simply not a type until it is named
    there -- and the failure arrives as "X is not a type" at load, with the
    whole config refusing to start.
    """
    qmldir = ROOT / "qmldir"
    if not qmldir.exists():
        return []
    listed = set()
    for line in qmldir.read_text().splitlines():
        parts = line.split()
        # Plain and singleton entries differ only in a leading keyword, and the
        # file is the last field of both.
        if parts and parts[-1].endswith(".qml"):
            listed.add(parts[-1])
    out = []
    for path in sorted(ROOT.glob("*.qml")):
        if path.name in ("shell.qml",) or path.name in listed:
            continue
        out.append((path.name, 1, "not listed in qmldir; it will not be a type"))
    return out


def raw_icon_lookups():
    """Icon lookups that bypass the one helper.

    A theme can hold a name at 16, 22 and 24 and nothing larger; asked for it at
    a larger size by name the engine fails, and IconImage draws Qt's magenta
    checkerboard while still reporting itself Ready. Icons.forName is the only
    call that gets this right, and the bug survived one fix precisely because
    there were three spellings of the lookup to find.
    """
    out = []
    for path in sorted(ROOT.glob("*.qml")):
        if path.name == "Icons.qml":
            continue
        for n, line in enumerate(path.read_text().splitlines(), 1):
            if line.lstrip().startswith("//"):
                continue
            if "Quickshell.iconPath" in line or "Quickshell.hasThemeIcon" in line:
                out.append((path.name, n, "icon looked up directly; use Icons.forName"))
    return out


def main():
    findings = []
    for path in sorted(list(ROOT.glob("*.qml")) + list((ROOT / "greeter").glob("*.qml"))):
        findings.extend(check(path))
    findings.extend(unregistered())
    findings.extend(raw_icon_lookups())

    for name, line, what in findings:
        print(f"{name}:{line}: {what}")
    print(f"\n{len(findings)} finding{'' if len(findings) == 1 else 's'}")
    return 1 if findings else 0


if __name__ == "__main__":
    sys.exit(main())
