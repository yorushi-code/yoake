// Запрещает mihomo регистрировать туннель в systemd-resolved.
//
// Запрет, а не разрешение -- и это не опечатка.
//
// DNS в туннеле работает через `dns-hijack: ["any:53"]`: mihomo перехватывает
// запросы к любому адресу на 53-м порту прямо в TUN, и systemd-resolved для
// этого не нужен вообще. Но при `tun.auto-route` mihomo вдобавок прописывает
// себя в resolved -- и прописывает туда 198.18.0.2, адрес из собственного
// fake-ip диапазона, плюс домен `~.` и default-route. Резолвер начинает слать
// все запросы на фиктивный адрес, и имена перестают разрешаться.
//
// Пока в сессии не было агента polkit, эти вызовы проваливались молча и всё
// работало. С агентом появился диалог -- четыре штуки, по одному на действие,
// -- а вместе с ним и возможность выдать разрешение, которое ломает DNS.
// Отказ здесь делает то же, что кнопка «Отмена», только без диалога.
//
// Побочный эффект: ручной `resolvectl dns ...` от этого пользователя тоже
// перестанет работать. Откат -- удалить файл, перезапуск polkitd не нужен.
//
// Ставится так:
//     sudo install -m 0644 install/polkit/49-mihomo-no-resolved.rules \
//         /etc/polkit-1/rules.d/

polkit.addRule(function (action, subject) {
    if (action.id.indexOf("org.freedesktop.resolve1.") !== 0) return;
    if (subject.user !== "yorushi") return;
    return polkit.Result.NO;
});
