binds {
    Mod+Return { spawn "kitty"; }
    Mod+F { spawn "firefox"; }
    Mod+E { spawn "nautilus"; }
    Mod+Backspace { toggle-overview; }
    Alt+F4 { close-window; }
    Mod+Shift+F { toggle-window-floating; }

    XF86MonBrightnessDown { spawn "yoake" "brightness" "lower"; }
    XF86MonBrightnessUp { spawn "yoake" "brightness" "raise"; }

    Print { spawn "yoake" "screenshot"; }
    Shift+Print { spawn "yoake" "screenshot" "--edit"; }
    Super+Print { spawn "yoake" "screenshot" "--full"; }
    Super+Shift+Print { spawn "yoake" "screenshot" "--full" "--edit"; }

    XF86PowerOff { spawn "yoake" "lock"; }
    Mod+L { spawn "yoake" "lock"; }

    Mod+Space { spawn "playerctl" "play-pause"; }
    XF86AudioPause { spawn "playerctl" "play-pause"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioMicMute { spawn "yoake" "volume" "mic-toggle"; }
    XF86AudioMute { spawn "yoake" "volume" "mute-toggle"; }
    XF86AudioLowerVolume { spawn "yoake" "volume" "lower"; }
    XF86AudioRaiseVolume { spawn "yoake" "volume" "raise"; }

    Mod+R { spawn "yoake" "reload"; }
    Mod+C { spawn "yoake" "msg" "toggle" "clipboard"; }
    Mod+D { spawn "yoake" "msg" "toggle" "launcher"; }
    Mod+Q { spawn "yoake" "msg" "toggle" "music"; }
    Mod+B { spawn "yoake" "msg" "toggle" "system"; }
    Mod+W { spawn "yoake" "msg" "toggle" "wallpaper"; }
    Mod+S { spawn "yoake" "msg" "toggle" "calendar"; }
    Mod+N { spawn "yoake" "msg" "toggle" "network"; }
    Mod+V { spawn "yoake" "msg" "toggle" "volume"; }
    Mod+H { spawn "yoake" "msg" "toggle" "guide"; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Down { focus-window-or-workspace-down; }

    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up { move-column-to-workspace-up; }
    Mod+Ctrl+Down { move-column-to-workspace-down; }

    Mod+Shift+Left { set-column-width "-5%"; }
    Mod+Shift+Right { set-column-width "+5%"; }
    Mod+Shift+Up { set-window-height "-5%"; }
    Mod+Shift+Down { set-window-height "+5%"; }

    Mod+1 { spawn "yoake" "msg" "workspace" "1"; }
    Mod+2 { spawn "yoake" "msg" "workspace" "2"; }
    Mod+3 { spawn "yoake" "msg" "workspace" "3"; }
    Mod+4 { spawn "yoake" "msg" "workspace" "4"; }
    Mod+5 { spawn "yoake" "msg" "workspace" "5"; }
    Mod+6 { spawn "yoake" "msg" "workspace" "6"; }
    Mod+7 { spawn "yoake" "msg" "workspace" "7"; }
    Mod+8 { spawn "yoake" "msg" "workspace" "8"; }
    Mod+9 { spawn "yoake" "msg" "workspace" "9"; }
    Mod+0 { spawn "yoake" "msg" "workspace" "10"; }

    Mod+Shift+1 { spawn "yoake" "msg" "workspace" "1" "move"; }
    Mod+Shift+2 { spawn "yoake" "msg" "workspace" "2" "move"; }
    Mod+Shift+3 { spawn "yoake" "msg" "workspace" "3" "move"; }
    Mod+Shift+4 { spawn "yoake" "msg" "workspace" "4" "move"; }
    Mod+Shift+5 { spawn "yoake" "msg" "workspace" "5" "move"; }
    Mod+Shift+6 { spawn "yoake" "msg" "workspace" "6" "move"; }
    Mod+Shift+7 { spawn "yoake" "msg" "workspace" "7" "move"; }
    Mod+Shift+8 { spawn "yoake" "msg" "workspace" "8" "move"; }
    Mod+Shift+9 { spawn "yoake" "msg" "workspace" "9" "move"; }
    Mod+Shift+0 { spawn "yoake" "msg" "workspace" "10" "move"; }
}
